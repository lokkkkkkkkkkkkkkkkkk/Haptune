          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketepatan anda untuk %1$@ meningkat daripada %2$@ kepada %3$@."
          }
        }
      }
    },
    "Your first split is free.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次分轨免费。"
          }
        },
        "zh-Hant": {
