    "You practised %@ less this week than last week. A short session today keeps your streak going.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周比上周少练了 %@。今天练一小段就能保持连续记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這週比上週少練了 %@。今天練一小段就能保持連續紀錄。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berlatih %@ kurang minggu ini berbanding minggu lalu. Sesi pendek hari ini mengekalkan rentetan anda."
          }
        }
      }
    },
    "You practised %@ more this week than last week.": {
