          }
        }
      }
    },
    "iCloud isn't available. Sign in with your Apple Account and turn on iCloud Drive in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用。请在“设置”中登录 Apple 账户并打开 iCloud 云盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 無法使用。請在「設定」中登入 Apple 帳號並開啟 iCloud 雲碟。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tidak tersedia. Log masuk dengan Akaun Apple anda dan hidupkan iCloud Drive dalam Tetapan."
          }
        }
      }
    },
    "iCloud keeps your pieces and practice history the same on iPhone, iPad and Mac. A backup is one .zip file you can keep in Files, Google Drive, Dropbox or OneDrive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 会让你的曲目和练习记录在 iPhone、iPad 和 Mac 上保持一致。备份是一个 .zip 文件，可以存放在“文件”、Google Drive、Dropbox 或 OneDrive 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 會讓你的曲目和練習紀錄在 iPhone、iPad 和 Mac 上保持一致。備份是一個 .zip 檔案，可以存放在「檔案」、Google Drive、Dropbox 或 OneDrive 中。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud memastikan lagu dan sejarah latihan anda sama pada iPhone, iPad dan Mac. Sandaran ialah satu fail .zip yang boleh disimpan dalam Fail, Google Drive, Dropbox atau OneDrive."
          }
        }
      }
    },
