    "Needed for scanning printed music, recordings to sheet music, Band Split and full reports. Practice, MusicXML, MIDI and jianpu work offline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描印刷乐谱、录音转乐谱、分轨和完整报告需要服务器。练习、MusicXML、MIDI 和简谱可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描印刷樂譜、錄音轉樂譜、分軌和完整報告需要伺服器。練習、MusicXML、MIDI 和簡譜可離線使用。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk mengimbas skor bercetak, rakaman kepada skor, Pisah Band dan laporan penuh. Latihan, MusicXML, MIDI dan jianpu berfungsi di luar talian."
          }
        }
