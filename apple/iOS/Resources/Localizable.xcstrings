          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune belum dapat membuka fail .%@."
          }
        }
      }
    },
    "Haptune needs the microphone to hear you play. Turn it on in Settings > Privacy & Security > Microphone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune 需要麦克风来听你演奏。请在“设置”>“隐私与安全性”>“麦克风”中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune 需要麥克風來聽你演奏。請在「設定」>「隱私權與安全性」>「麥克風」中開啟。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune memerlukan mikrofon untuk mendengar anda bermain. Hidupkan dalam Tetapan > Privasi & Keselamatan > Mikrofon."
          }
        }
      }
    },
