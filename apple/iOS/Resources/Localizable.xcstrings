    "Band Split is part of Haptune Plus.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分轨功能属于 Haptune Plus。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分軌功能屬於 Haptune Plus。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisah Band ialah sebahagian daripada Haptune Plus."
          }
        }
      }
    },
    "Band Split runs on your Haptune server. Add its address in Settings > Analysis Server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分轨在你的 Haptune 服务器上运行。请在“设置”>“分析服务器”中填写地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分軌在你的 Haptune 伺服器上執行。請在「設定」>「分析伺服器」中填寫位址。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisah Band berjalan pada pelayan Haptune anda. Tambah alamatnya dalam Tetapan > Pelayan Analisis."
          }
        }
      }
    },
