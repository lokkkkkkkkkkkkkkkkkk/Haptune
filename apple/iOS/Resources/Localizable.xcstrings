    "Your accuracy on %@ rose from %@ to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在《%1$@》上的准确率从 %2$@ 提高到 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
