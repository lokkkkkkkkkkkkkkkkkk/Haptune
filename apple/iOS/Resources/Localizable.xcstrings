    "Haptune can write sheet music for one instrument, or split a band recording into a part for each instrument.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune 可以为单一乐器写出乐谱，也可以把乐队录音按乐器分成各个声部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune 可以為單一樂器寫出樂譜，也可以把樂團錄音按樂器分成各個聲部。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptune boleh menulis skor untuk satu alat muzik, atau memisahkan rakaman band kepada bahagian bagi setiap alat."
          }
        }
      }
    },
    "Haptune can't open .%@ files yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
