    "Add your analysis server in Account > Analysis Server to get the full report.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“账户”>“分析服务器”中添加服务器，即可获得完整报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「帳號」>「分析伺服器」中加入伺服器，即可取得完整報告。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah pelayan analisis anda dalam Akaun > Pelayan Analisis untuk mendapatkan laporan penuh."
