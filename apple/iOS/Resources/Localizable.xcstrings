{
  "sourceLanguage": "en",
  "strings": {
    "%@ is in your library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在你的曲库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在你的曲庫中。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ada dalam pustaka anda."
          }
        }
      }
    },
    "%@ of your notes were in tune this week.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周你有 %@ 的音是准的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週你有 %@ 的音是準的。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ daripada not anda tepat nada minggu ini."
          }
        }
      }
    },
    "%@ string %@¢": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 弦 %2$@¢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 弦 %2$@¢"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tali %1$@ %2$@¢"
          }
        }
      }
    },
    "%lld BPM": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld BPM"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld BPM"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld BPM"
          }
        }
      }
    },
    "%lld days in a row. Musicians who practise a little every day improve fastest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连续 %lld 天。每天练一点的人进步最快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連續 %lld 天。每天練一點的人進步最快。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hari berturut-turut. Pemuzik yang berlatih sedikit setiap hari paling cepat maju."
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
    "%lld parts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个声部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個聲部"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bahagian"
          }
        }
      }
    },
    "%lld pieces": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 首曲目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 首曲目"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld lagu"
          }
        }
      }
    },
    "1 week free, then billed once a year": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费 1 周，之后每年扣费一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費 1 週，之後每年扣款一次"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma 1 minggu, kemudian dibilkan setahun sekali"
          }
        }
      }
    },
    "1–7 = scale degrees, 0 = rest, - = hold a beat, _ = half the length, . = dotted, ' up an octave, , down an octave, | bar line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1–7 = 音级，0 = 休止，- = 延长一拍，_ = 时值减半，. = 附点，' 高八度，, 低八度，| 小节线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1–7 = 音級，0 = 休止，- = 延長一拍，_ = 時值減半，. = 附點，' 高八度，, 低八度，| 小節線。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1–7 = darjah skala, 0 = rehat, - = tahan satu ketuk, _ = separuh panjang, . = bertitik, ' naik satu oktaf, , turun satu oktaf, | garis bar."
          }
        }
      }
    },
    "30 seconds or more works best. Keep the phone close to the music.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒以上效果最好。让手机靠近音乐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 秒以上效果最好。讓手機靠近音樂。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "30 saat atau lebih paling baik. Dekatkan telefon dengan muzik."
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "7 hari"
          }
        }
      }
    },
    "A Band or a Song (Band Split)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乐队或整首歌（分轨）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樂團或整首歌（分軌）"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Band atau Lagu (Pisah Band)"
          }
        }
      }
    },
    "A short session today makes tomorrow easier. Even 10 minutes counts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天练一小段，明天会更轻松。哪怕 10 分钟也算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天練一小段，明天會更輕鬆。哪怕 10 分鐘也算。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi pendek hari ini memudahkan esok. 10 minit pun dikira."
          }
        }
      }
    },
