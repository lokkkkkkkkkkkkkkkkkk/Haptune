    "Install Haptune on your Apple Watch to feel a tap the moment a note is wrong, sharp, flat, rushed or dragged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 上安装 Haptune，音弹错、偏高、偏低、抢拍或拖拍时，手腕会立即轻触提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 上安裝 Haptune，音彈錯、偏高、偏低、搶拍或拖拍時，手腕會立即輕觸提醒你。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Haptune pada Apple Watch untuk rasa ketukan sebaik sahaja not salah, terlalu tinggi, terlalu rendah, tergesa-gesa atau terlambat."
          }
        }
      }
    },
